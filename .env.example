# Copy to .env (git-ignored) and fill in. Read by docker compose and by `rag-ingest load`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
# Required: Qdrant demands it on every request (an empty value locks everyone out).
QDRANT_API_KEY=change-me-too

# OCR API (`rag-ingest ocr --engine api`). OCR_API_KEY only if the server needs one.
OCR_API_URL=https://ocr.example.com/v1/chat/completions
OCR_API_MODEL=typhoon-ai/typhoon-ocr1.5-2b
OCR_API_KEY=
