# Copy to .env (git-ignored) and fill in. Read by docker compose, `rag-ingest load` and `rag-ingest ocr`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
# Required: Qdrant demands it on every request (an empty value locks everyone out).
QDRANT_API_KEY=change-me-too

# Internal model API endpoints. URLs point to company-hosted services.
EMBED_API_URL=
EMBEDDING_MODEL=bge-m3
# Optional legacy override; when set, this takes precedence over EMBEDDING_MODEL.
EMBED_API_MODEL=
EMBED_API_KEY=
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=typhoon-rag

# HTTP API (planned, not implemented yet; see README "Next: HTTP API"). The API must
# take user id and role from a verified token, never from the request body.
# API_HOST=127.0.0.1
# API_PORT=8000
# API_AUTH_TOKEN=
