# Copy to .env (git-ignored) and fill in. Read by docker compose and by `rag-ingest load`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
# Optional; when set, Qdrant requires it on every request.
QDRANT_API_KEY=
